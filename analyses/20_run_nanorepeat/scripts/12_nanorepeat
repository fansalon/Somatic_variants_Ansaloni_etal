
#!/bin/bash
#
#PBS -q workq
#PBS -l select=1:ncpus=8:mem=200gb
#PBS -l walltime=120:00:00
#PBS -j oe
#PBS -N 12_nanorepeat

cd $PBS_O_WORKDIR

source activate nanorepeat
module load samtools

###################################################################################################################################
### Arguments
bam=/projects/somatic_mouse_tissues/bam_mm2/WT_5_KID.bam
genome=/projects/somatic_mouse_tissues/ONT/sniffles/genome/GRCm39.primary_assembly.genome.fa
bed=/projects/somatic_mouse_tissues/ONT/nanorepeat/input/input_SR.bed
output=/projects/somatic_mouse_tissues/ONT/nanorepeat/output/
###################################################################################################################################

# create sample-specific out dir
name=$(basename $bam | awk -F ".bam" '{ print $1 }')
output=${output}/${name}/${name}

# get the SR of interest for this specific sample
bed2=bed_of_interest_WT_5_29374.bed
grep WT_5 $bed | cut -f 1-4 | sort | uniq | sort -k1,1 -k2,2g > ${bed2}



date
nanoRepeat.py -i $bam -t bam -d ont_sup -r $genome -b ${bed2} -c 8 -o $output >> log_${name} 2>&1
echo Done
date

